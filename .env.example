# --- Required ---
# OpenAI API key used for both triage (gpt-5-nano) and synthesis (gpt-5-mini)
OPENAI_API_KEY=sk-...

# --- Optional ---
# Dev.to API key. If absent, cross-posting is skipped with a warning.
DEV_TO_API_KEY=

# Maximum number of stories in the daily digest (default: 6)
MAX_STORIES=6

# Per-article word cap applied before any LLM call (default: 1800)
MAX_ARTICLE_WORDS=1800

# Hard per-run cost ceiling in USD. The pipeline aborts before exceeding it. (default: 0.25)
DAILY_COST_CAP_USD=0.25

# When true, run the full pipeline but write output to ./out/ instead of
# committing to the site and publishing. (default: false)
DRY_RUN=false

# Public URL of the deployed site, used for canonical URLs on Dev.to cross-posts.
SITE_URL=https://example.com
