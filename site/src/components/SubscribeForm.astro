---
// Phase 2 placeholder: wire the form action to Buttondown/Resend when the
// email subscription launches. Kept visible from day one to collect intent.
---

<section class="subscribe" aria-label="Email subscription">
  <h2>Start your day already caught up</h2>
  <p>Tomorrow's briefing in your inbox before your first coffee. Free, two minutes a day.</p>
  <form action="#" method="post" onsubmit="return false">
    <input type="email" name="email" placeholder="you@example.com" autocomplete="email" required />
    <button type="submit">Get the briefing</button>
    <p class="note">One email a day. No spam, unsubscribe anytime. Launching soon.</p>
  </form>
</section>
